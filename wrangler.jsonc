{
  "name": "automation",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "DRIVE",
      "bucket_name": "apex-drive"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT_STATE",
        "class_name": "AgentDurableObject"
      },
      {
        "name": "SCHEDULER",
        "class_name": "WorkflowScheduler"
      }
    ]
  },
  "workflows": [
    {
      "name": "automation-workflow",
      "binding": "AUTOMATION_WORKFLOW",
      "class_name": "AutomationWorkflow"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AgentDurableObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["WorkflowScheduler"]
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
