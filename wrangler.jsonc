{
  "name": "automation",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  // Apex Drive storage is Backblaze B2 (10 GB free, no card required).
  // Replace the region in the endpoint with the one shown on your B2 bucket page.
  // The key id and app key are secrets, never stored here:
  //   npx wrangler secret put DRIVE_B2_KEY_ID
  //   npx wrangler secret put DRIVE_B2_APP_KEY
  "vars": {
    "DRIVE_B2_BUCKET": "apex-drive",
    "DRIVE_B2_ENDPOINT": "https://s3.us-west-004.backblazeb2.com"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT_STATE",
        "class_name": "AgentDurableObject"
      },
      {
        "name": "SCHEDULER",
        "class_name": "WorkflowScheduler"
      }
    ]
  },
  "workflows": [
    {
      "name": "automation-workflow",
      "binding": "AUTOMATION_WORKFLOW",
      "class_name": "AutomationWorkflow"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AgentDurableObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["WorkflowScheduler"]
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
